BETTER_AUTH_URL=http://localhost:5173  # <- apps/server/src/auth/auth.config.ts — the origin the BROWSER uses: Vite's in dev (it proxies /api to the server), the deployed host in production; every Better Auth URL (OAuth callbacks included) is built from it, and it is trusted as an origin
BETTER_AUTH_SECRET=                    # <- apps/server/src/auth/auth.config.ts — signs the session cookie; at least 32 characters (`openssl rand -base64 32`); the boot refuses a shorter one
AUTH_FROM_EMAIL=__AUTH_FROM_EMAIL__    # <- apps/server/src/auth/auth.config.ts — the sender of the sign-in code, handed to the notification port's `sendEmail`
MOBILE_SCHEME=                         # <- apps/server/src/auth/auth.config.ts — the Expo app's deep-link schemes, comma-separated, trusted as `<scheme>://` origins; default: one per installed variant (__SCHEME__, __SCHEME__-preview, __SCHEME__-dev — apps/mobile/.env.example)
AUTH_TRUSTED_ORIGINS=                  # <- apps/server/src/auth/auth.config.ts — extra origins the auth routes accept, comma-separated (a LAN host a phone's browser reaches the dev server on, a support tool); empty by default
COOKIE_DOMAIN=                         # <- apps/server/src/auth/auth.config.ts — share the session cookie across subdomains (`.example.com`); honoured over https only, host-only cookies otherwise
CLIENT_IP_HEADER=                      # <- apps/server/src/auth/otp-protection.ts — the one header the per-IP rate limiter reads the client address from; default x-forwarded-for
GOOGLE_CLIENT_ID=                      # <- apps/server/src/auth/auth.config.ts — Google sign-in; registered only when both halves of the pair are set
GOOGLE_CLIENT_SECRET=                  # <- apps/server/src/auth/auth.config.ts
APPLE_CLIENT_ID=                       # <- apps/server/src/auth/auth.config.ts — Apple sign-in; registered only when both halves of the pair are set
APPLE_CLIENT_SECRET=                   # <- apps/server/src/auth/auth.config.ts
