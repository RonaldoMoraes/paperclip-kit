LLM_MODE=fake                   # <- apps/server/src/llm/llm.config.ts — fake | real; unset means real, so a deploy never silently answers from the fake
#AGENT_RUNTIME=native           # <- apps/server/src/llm/llm.config.ts — native (default) | openai-agents; the SDK adapter always reaches the real vendor, LLM_MODE or not
OPENAI_API_KEY=                 # <- apps/server/src/llm/llm.config.ts — required in real mode: the shipped registry routes every service to openai
ANTHROPIC_API_KEY=              # <- apps/server/src/llm/llm.config.ts — required only once the registry routes a service (or a fallback) to anthropic
ANTHROPIC_BASE_URL=             # <- apps/server/src/llm/llm.config.ts — optional; a proxy in front of the Anthropic API
GEMINI_API_KEY=                 # <- apps/server/src/llm/llm.config.ts — required only once the registry routes a service (or a fallback) to google
XAI_API_KEY=                    # <- apps/server/src/llm/llm.config.ts — required only once the registry routes a service (or a fallback) to xai
XAI_BASE_URL=                   # <- apps/server/src/llm/llm.config.ts — optional; a proxy in front of the xAI API
