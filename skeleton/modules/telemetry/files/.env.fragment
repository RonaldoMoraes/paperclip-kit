LOG_LEVEL=info                  # <- apps/server/src/telemetry/telemetry.config.ts (debug | info | warn | error; a line below it is dropped)
LOG_HEALTH=true                 # <- apps/server/src/telemetry/telemetry.config.ts (false silences the access line for GET /api/health — a load balancer's probe is noise)
OTEL_SERVICE_NAME=__PRODUCT_SLUG__   # <- apps/server/src/telemetry/telemetry.config.ts (service.name on every span)
OTEL_EXPORTER_OTLP_ENDPOINT=    # <- apps/server/src/telemetry/telemetry.config.ts (an OTLP/HTTP collector's base URL; spans go to <endpoint>/v1/traces; unset → nothing exported)
OTEL_CONSOLE=true               # <- apps/server/src/telemetry/telemetry.config.ts (print every span to the console — dev only; leave unset in production)
