SENTRY_DSN=                     # <- apps/server/src/observability/observability.config.ts — the server project's DSN; unset (default): Sentry never initialises and every error is one JSON line on the console
SENTRY_ENVIRONMENT=             # <- apps/server/src/observability/observability.config.ts — `environment` on every event; unset → NODE_ENV
SENTRY_RELEASE=                 # <- apps/server/src/observability/observability.config.ts — `release` on every event (a commit sha, a version; the deploy sets it from COMMIT_SHA); unset → the SDK's own default
SENTRY_TRACES_SAMPLE_RATE=0     # <- apps/server/src/observability/observability.config.ts — 0 (default): errors only; 0 < n ≤ 1: that share of requests becomes a trace and Sentry owns OpenTelemetry (docs/observability-sentry.md, Traces)
VITE_SENTRY_DSN=                # <- apps/web/src/lib/sentry.ts — the web project's DSN, inlined at build time (the deploy passes it as a build arg); unset: no init, no SDK traffic
VITE_SENTRY_ENVIRONMENT=        # <- apps/web/src/lib/sentry.ts — `environment` on every web event; unset → the Vite mode (development | production)
# EXPO_PUBLIC_SENTRY_DSN and EXPO_PUBLIC_SENTRY_ENVIRONMENT belong to apps/mobile/.env (Expo reads the app's own file), where apps/mobile/.env.example declares them; they are read by apps/mobile/src/lib/sentry.ts — docs/observability-sentry.md, Mobile
