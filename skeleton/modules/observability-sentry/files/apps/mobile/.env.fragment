EXPO_PUBLIC_SENTRY_DSN=          # <- apps/mobile/src/lib/sentry.ts — the mobile project's DSN, inlined by Metro at build time (set it on each EAS environment too, and restart Metro with --clear after a change); unset (default): no init, no SDK traffic
EXPO_PUBLIC_SENTRY_ENVIRONMENT=  # <- apps/mobile/src/lib/sentry.ts — `environment` on every mobile event; unset → what the build is (development in a debug build, production otherwise)
