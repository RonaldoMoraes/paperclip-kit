STRIPE_SECRET_KEY=                # <- apps/server/src/subscription/subscription.config.ts — THE SWITCH: unset means no client, no plugin and no billing at all (mock mode, the gates and a plain local stack run this way); set it and the next three become required at boot
STRIPE_WEBHOOK_SECRET=            # <- apps/server/src/subscription/subscription.config.ts — the `whsec_…` that signs the deliveries; in development it is what `stripe listen --forward-to localhost:3000/api/auth/stripe/webhook` prints
STRIPE_PRICE_MONTHLY=             # <- apps/server/src/subscription/subscription.config.ts — the Stripe price id behind the `monthly` plan; the browser never names a price, only a plan
STRIPE_PRICE_ANNUAL=              # <- apps/server/src/subscription/subscription.config.ts — the Stripe price id behind the `annual` plan
STRIPE_PORTAL_CONFIGURATION=      # <- apps/server/src/subscription/subscription.config.ts — optional: the billing-portal configuration (`bpc_…`) to open instead of the Stripe account's default
