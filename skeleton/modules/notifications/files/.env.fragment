NOTIFICATION_MODE=fake          # <- apps/server/src/notification/notification.config.ts — fake (default): every channel prints to the console, nothing is sent; real: SendGrid + Twilio + Expo, and every key below but EXPO_ACCESS_TOKEN is required
SENDGRID_API_KEY=               # <- apps/server/src/notification/notification.config.ts — SendGrid API key with the Mail Send permission (real only)
NOTIFICATION_FROM_EMAIL=        # <- apps/server/src/notification/notification.config.ts — default sender, a verified SendGrid identity; a request's own `from` overrides it (real only)
SMS_ACCOUNT_SID=                # <- apps/server/src/notification/notification.config.ts — Twilio Account SID (starts with AC; the adapter authenticates with the account, not an API key) (real only)
SMS_AUTH_TOKEN=                 # <- apps/server/src/notification/notification.config.ts — Twilio Auth Token of that account (real only)
SMS_FROM=                       # <- apps/server/src/notification/notification.config.ts — default SMS sender: an E.164 number the account owns (real only)
EXPO_ACCESS_TOKEN=              # <- apps/server/src/notification/notification.config.ts — optional; Expo push access token, needed only when the Expo project turned on enhanced push security (real only)
