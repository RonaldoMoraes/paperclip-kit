ANALYTICS_MODE=fake             # <- apps/server/src/analytics/analytics.config.ts — fake (default): every batch is a console line, nothing is stored; real: MongoDB, and ANALYTICS_MONGODB_URL is required
ANALYTICS_MONGODB_URL=          # <- apps/server/src/analytics/analytics.config.ts — the cluster's connection string, e.g. mongodb://localhost:27017 (real only)
ANALYTICS_MONGODB_DB=           # <- apps/server/src/analytics/analytics.config.ts — the database on that cluster; defaults to __PRODUCT_SLUG__-analytics (real only)
