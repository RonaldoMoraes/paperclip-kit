# The reference copy module `yarn copy:diff` holds `@domain/copy` against (docs/copy-diff.md).
# Unset → the run reports "no reference configured" and exits 0.
COPY_DIFF_PATH=                 # <- scripts/copy-diff.ts  on disk: relative to this root (e.g. reference/copy.example.ts); with COPY_DIFF_REF: relative to the git repo root
COPY_DIFF_REF=                  # <- scripts/copy-diff.ts  optional git ref (e.g. origin/design-export); set → the reference is `git show REF:PATH`, no checkout needed
