{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "isolatedModules": false,
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "types": ["node"],
    "baseUrl": "./",
    "paths": {
      "@contracts/*": ["../../shared/contracts/*"],
      "@domain/*": ["../../shared/domain/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
