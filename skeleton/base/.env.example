# Every variable here names the one file that reads it (`# <- path`). A variable no
# file reads is deleted; a file that reads a variable not listed here is a bug.
# Modules append their own block under a `# --- <module> ---` header.
#
# `.env` (gitignored) holds the real values; copy this file to start:  cp .env.example .env

# --- base ---
NODE_ENV=development            # <- apps/server/src/main.ts
PORT=3000                       # <- apps/server/src/main.ts (worktree slots run base + 10 × slot)
