# ── The one server this app talks to ──────────────────────────────────────────
# apps/server, running locally (`yarn dev:server` at the repo root).
# Leave unset to take the per-platform default:
#   Android emulator → http://10.0.2.2:3000   (the emulator's NAT alias for the host)
#   iOS simulator    → http://localhost:3000  (shares the host's loopback)
# A physical device needs the host's LAN address, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=

# ── Run mode ──────────────────────────────────────────────────────────────────
# `real` (or unset) talks to EXPO_PUBLIC_API_URL. `mock` answers every request from the
# contract mocks inside the app — `yarn mobile:mock` at the repo root sets it, and no
# server has to be running. Local debug builds only (`__DEV__`); every EAS binary is a
# release build and ignores it. Either value is inlined into the bundle when Metro
# transforms it, so a change needs Metro restarted with --clear before the app sees it.
EXPO_PUBLIC_API_MODE=real

# ── Variant identity ──────────────────────────────────────────────────────────
# Three variants install side by side on one device, each with its own name, bundle id
# and deep-link scheme. Locally these default to the development values; on EAS every
# one is set on the matching environment (`eas env:list --environment <name>`), and a
# build with any of them unset fails in app.config.js.
#
#                development           preview               production
#   VARIANT      development           preview               production
#   BUNDLE_ID    __BUNDLE_ID__.dev     __BUNDLE_ID__.preview __BUNDLE_ID__
#   SCHEME       __SCHEME__-dev        __SCHEME__-preview    __SCHEME__
#
# The server trusts `<scheme>://` as a request origin; a module that signs in through
# the system browser (the auth module) returns on it.
MOBILE_VARIANT=development
MOBILE_BUNDLE_ID=__BUNDLE_ID__.dev
EXPO_PUBLIC_SCHEME=__SCHEME__-dev

# ── EAS project ───────────────────────────────────────────────────────────────
# The id `eas init` prints (also `eas project:info`). It names the updates URL and the
# project every `eas` command targets; set it on each EAS environment as well. Unset until
# the project exists on expo.dev — a local run never loads an update.
EAS_PROJECT_ID=

# ── Metro ─────────────────────────────────────────────────────────────────────
# The dev server's port. 8300 is the base; a worktree slot adds 10 × slot (see
# docs/worktrees.md), and `yarn mobile` passes it to `expo start --port`.
# METRO_PORT=8300
